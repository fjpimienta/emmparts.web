# Production environment for EMM PARTS (Plesk + Phusion Passenger).
# Set these as "Custom environment variables" in the Plesk Node.js panel —
# do not create a real .env file on the server.

# Public catalog: sign-in is off. Also baked into the client bundle at build
# time (the build reads .grok/app-env.json, which already sets it to "false").
VITE_AUTH_ENABLED=false

# DATABASE_URL — intentionally NOT set in production.
# The site has no database. If DATABASE_URL were set while auth is off,
# requireUserId() fails closed by design and every server function that needs a
# user would reject the request. Leave it unset unless the app gains accounts.
# DATABASE_URL=postgres://user:password@host:5432/dbname
